# MG5_aMC 3.5.1 control for scalar electroweak WZ and Wgamma amplitudes.
# MSSM_SLHA2 replaces legacy 'mssm'. u_L and d_L squarks are
# EW scalar doublet controls but carry QCD (not infracolor) color.
# DO NOT interpret production cross sections as bound-state partial widths.
set gauge unitary
import model MSSM_SLHA2
generate ul dl~ > w+ z QCD=0 QED=2
output standalone MG5_UL_DL_WZ -f
generate ul dl~ > w+ a QCD=0 QED=2
output standalone MG5_UL_DL_WA -f
